    "rtl":  [("어제 가격", "rtl_prc_lag1"), ("최근7일 평균", "rtl_prc_avg7"),
             ("최근14일 평균", "rtl_prc_avg14"), ("작년 동시기", "rtl_prc_prev_yr")],
}
CANDS = BASE_CANDS["whsl"]      # main() 에서 타겟에 맞게 교체된다

# 타겟별 추가 제외
TARGET_DROP = {
    "auc":  set(ECON_COLS) | set(SCHOOL_COLS),
    "whsl": set(ECON_COLS) | set(SCHOOL_COLS),
    "rtl":  set(ECON_COLS) | set(WEATHER_COLS) | set(SCHOOL_COLS),
